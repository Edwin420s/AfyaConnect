# ==============================================================================
# AfyaConnect Frontend (Vite + React) Environment Configuration
# ==============================================================================
# Copy this file to '.env' or '.env.local' in the root directory:
#   cp .env.example .env
#
# Vite requires client-exposed variables to be prefixed with 'VITE_'.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Service URL
# ------------------------------------------------------------------------------
# Points to the FastAPI backend service.
# - Local development default: http://localhost:8000/api
# - Remote/Production example: https://api.afyaconnect.co.ke/api
VITE_API_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# Anthropic Claude API Key (Optional for Client-Side Direct Execution)
# ------------------------------------------------------------------------------
# If provided, the React client can query Claude directly via browser fetch.
# Note: In production, it is recommended to keep your API key on the backend
# (in backend/.env) to prevent exposing your Anthropic secret in the client bundle.
# Leave blank to automatically route all Claude queries through the secure backend API.
VITE_ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Claude Model Selection
# ------------------------------------------------------------------------------
# Options:
# - claude-3-7-sonnet-20250219 (Recommended default: Hybrid reasoning & clinical tool use)
# - claude-3-5-sonnet-20241022 (Clinical triage & high accuracy)
# - claude-3-5-haiku-20241022  (Ultra-low latency triage responses)
VITE_CLAUDE_MODEL=claude-3-7-sonnet-20250219

# ------------------------------------------------------------------------------
# Default Healthcare Facility Identifier
# ------------------------------------------------------------------------------
# Default facility ID for the Hospital Reception Dashboard context.
# Available seeded IDs:
# - f-agakhan    (Aga Khan University Hospital, Level 6 Referral)
# - f-mpshah     (MP Shah Hospital, Level 5 Hospital)
# - f-westlands  (Westlands Sub-County Clinic, Level 4 Public)
VITE_DEFAULT_FACILITY_ID=f-agakhan

# ------------------------------------------------------------------------------
# Feature Toggles
# ------------------------------------------------------------------------------
# Enable or disable the audio consultation recording simulator (true/false)
VITE_ENABLE_AUDIO_RECORDER=true

# ------------------------------------------------------------------------------
# Vite Development Server Port
# ------------------------------------------------------------------------------
PORT=5173
