# ==============================================================================
# AfyaConnect Backend (FastAPI + SQLAlchemy) Environment Configuration
# ==============================================================================
# Copy this file to '.env' in the backend directory:
#   cp backend/.env.example backend/.env
#
# These variables are read by the FastAPI backend server, Claude orchestrator,
# and database connection layer.
# ==============================================================================

# ------------------------------------------------------------------------------
# Anthropic Claude API Configuration
# ------------------------------------------------------------------------------
# Required for live Claude 3.7 / 3.5 Sonnet conversational triage and clinical tool calling.
# If omitted or left blank, the backend automatically falls back to the built-in
# local clinical decision engine (zero downtime).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Claude model for medical triage and clinical tool execution:
# - claude-3-7-sonnet-20250219 (Recommended: Hybrid reasoning, multi-turn tool calling)
# - claude-3-5-sonnet-20241022 (Clinical triage accuracy)
# - claude-3-5-haiku-20241022  (Fast response times)
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# ------------------------------------------------------------------------------
# Database Connection URL
# ------------------------------------------------------------------------------
# Supports SQLite (default for development/testing) or PostgreSQL (production).
# SQLite:
DATABASE_URL=sqlite:///./afyaconnect.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/afyaconnect

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Replace with a cryptographically secure random string in production:
# e.g., generated with: openssl rand -hex 32
SECRET_KEY=afyaconnect-secret-key-nairobi-2026-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Kenyan Emergency Healthcare Hotlines
# ------------------------------------------------------------------------------
KENYA_EMERGENCY_HOTLINE_RED_CROSS=1199
KENYA_EMERGENCY_HOTLINE_POLICE=999
KENYA_EMERGENCY_HOTLINE_NATIONAL=112

# ------------------------------------------------------------------------------
# Notification & SMS Gateway Simulation
# ------------------------------------------------------------------------------
# When true, SMS and WhatsApp digital token passes are simulated and logged to the database.
SMS_GATEWAY_SIMULATION=true

# ------------------------------------------------------------------------------
# Application Logging Level
# ------------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
